# Archivos que Claude Code no necesita leer

# Entorno virtual y dependencias instaladas
.venv/
venv/
*.egg-info/

# Cachés de Python y herramientas
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Control de versiones y sistema operativo
.git/
.DS_Store

# Datos generados al ejecutar la app (main.py guarda en el directorio actual)
src/*.json
*.csv
